pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'GitHub 연결 성공!'
            }
        }

        stage('Build') {
            steps {
                echo '빌드 테스트 성공!'
            }
        }

        stage('Test') {
            steps {
                echo '자동 테스트 성공!'
            }
        }
    }
}
